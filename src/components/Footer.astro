---
import Container from "./Container.astro";
---

<footer>
  <div class="border-t-1 my-16 sm:my-24 lg:my-32 text-white/10"></div>
  <Container>
    <div class="flex flex-col gap-y-10 sm:grid sm:grid-cols-2 sm:gap-y-0 sm:justify-between">
      <div class="flex flex-col">
        <div class="flex flex-row items-center gap-x-2">
          <img src="/logo.svg" alt="Logo Stride" class="w-auto h-[20px]" />
          <p class="text-xl font-bold">Stride</p>
        </div>
        <p class="mt-4 font-sans text-sm text-white/80">
          Apps built with focus, shipped with care. A <br /> quality-of-life software
          & IoT studio.
        </p>
      </div>

      <div class="grid grid-cols-2">
        <div class="flex flex-col gap-y-2">
          <p class="font-mono text-sm text-white/60">PRODUCTS</p>
          <a href="https://focus.appstride.org" class="cursor-pointer hover:text-brand font-mono text-sm text-white/80">Focus</a>
          <a href="#apps" class="cursor-pointer hover:text-brand font-mono text-sm text-white/80">Device</a>
          <a href="#apps" class="cursor-pointer hover:text-brand font-mono text-sm text-white/80">Catalogue</a>
          <!-- <a href="#apps" class="cursor-pointer hover:text-brand font-mono text-sm text-white/80">Upcoming launches</a> -->
        </div>

        <div class="flex flex-col gap-y-2">
          <p class="font-mono text-sm text-white/60">STUDIO</p>
          <a href="#philosophy" class="cursor-pointer hover:text-brand font-mono text-sm text-white/80">Philosophy</a>
          <a href="https://github.com/Larzt" class="cursor-pointer hover:text-brand font-mono text-sm text-white/80">GitHub · Larzt</a>
        </div>
      </div>
    </div>

    <div class="mt-32 sm:mt-48 lg:mt-64">
      <p class="stride-outline text-center font-display font-bold text-5xl sm:text-8xl lg:text-[12rem] leading-none">STRIDE</p>
      <div class="border-b-1 border-white/10"/>
    </div>
    <div class="mt-6 flex flex-col gap-y-3 sm:flex-row sm:justify-between sm:gap-y-0">
      <p class="font-mono text-xs text-white/60">© 2026 Stride · appstride.org</p>
      <div class="flex flex-row items-center gap-x-2">
        <div class="flex items-center justify-center size-3 border-1 border-brand rounded-full">
          <div class="size-1.5 bg-brand rounded-full"/>
        </div>
        <p class="font-mono text-xs text-white/60">Crafted in Tenerife</p>
      </div>
    </div>
  </Container>
</footer>

<style>
  .stride-outline {
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.2);
  }
</style>
