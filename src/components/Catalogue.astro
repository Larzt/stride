---
import Container from "./Container.astro";
import EmptyApp from "./EmptyApp.astro";
import AppCard from "./AppCard.astro";

---

<Container>
  <section id="apps" class="mt-32 sm:mt-48 lg:mt-64">
    <div class="border-t-1 my-8 text-white/10"/>
    <div class="flex flex-col gap-y-4 sm:grid sm:grid-cols-2 sm:gap-y-0 sm:items-end">
      <div>
        <p class="font-mono text-xs text-white/60 "><span class="text-brand">01</span> - APPS</p>
        <p class="font-display font-bold text-4xl lg:text-[3rem]">The catalogue</p>
      </div>
        <p class="font-sans text-sm text-white/60 sm:text-right">One app, fully shipped. The rest are <br/> on the way.</p>
    </div>

    <AppCard
      class="mt-6"
      name="Tenique"
      badge="v1.3 · WIP"
      logo="/logo.svg"
      image="/tenique.png"
      tech="WINDOWS · DESKTOP"
      number="01"
      features={[
        { color: "bg-brand",  title: "Guided bookings.", text: "Pick-ups, returns, home deliveries and a waiting list, step by step." },
        { color: "bg-yellow", title: "Several counters, no server.", text: "Every counter shares its data through a SQLite database on a network folder." },
        { color: "bg-pink",   title: "An admin panel.", text: "Activity, statistics and Excel export, with a self-contained installer built on every push." },
      ]}
    >
      <p slot="title" class="font-display font-semibold text-xl text-balance">Machine and tool lending, <span class="text-brand">from every counter</span>.</p>
      <p slot="description" class="font-sans text-sm text-white/80 text-pretty">A Windows desktop app built for Tenique to run the lending of machines and tools from several counters at once. Written in C# with WPF.</p>
    </AppCard>

    <AppCard
      class="mt-6"
      name="Tagoror"
      badge="v5.0"
      logo="/tagoror.svg"
      image="/tagoror-mockup.png"
      video="/tagoror-trailer.mp4"
      url="https://tagoror.appstride.org"
      features={[
        { color: "bg-brand",  title: "Notes your way.", text: "Text, Markdown, checklists and voice notes with a live waveform — all one Ctrl+K away." },
        { color: "bg-yellow", title: "Your day, organised.", text: "Reminders that actually ring, a day/week/month planner, timers and birthdays." },
        { color: "bg-pink",   title: "Synced between computers.", text: "Google Drive, WebDAV or a synced folder, merging per element instead of overwriting." },
      ]}
    >
      <p slot="title" class="font-display font-semibold text-xl text-balance">Notes, reminders and a planner that live <span class="text-brand">on your desktop</span>.</p>
      <p slot="description" class="font-sans text-sm text-white/80 text-pretty">Tagoror is a frameless, translucent panel for Linux and Windows, written in C++20 with Qt 6. Available on the AUR, as an AppImage, a Flatpak and a Windows installer.</p>
    </AppCard>

    <AppCard
      class="mt-6"
      name="Stride Device"
      badge="PROTOTYPE"
      logo="/logo.svg"
      image="/iot-device.jpeg"
      tech="ESP32 · IOT"
      number="03"
      features={[
        { color: "bg-brand",  title: "Scriptable.", text: "Your logic lives in scripts written in our own DSL, interpreted on the device." },
        { color: "bg-yellow", title: "Connected.", text: "WiFi in AP and STA mode, a built-in HTTP server and a TFT display." },
        { color: "bg-pink",   title: "Modular to the core.", text: "New hardware on the I2C bus, endpoints or DSL commands plug in as isolated modules." },
      ]}
    >
      <p slot="title" class="font-display font-semibold text-xl text-balance">Modular <span class="text-brand">IoT, zero</span> friction.</p>
      <p slot="description" class="font-sans text-sm text-white/80 text-pretty">Stride takes the complexity out of IoT. A modular ESP32 device you reconfigure without touching its core — configure it once, and let it run.</p>
    </AppCard>
    <!-- <div class="mt-6 grid grid-cols-2 gap-x-4">
      <AppCard name="Device" badge="PROTOTYPE" logo="/logo.svg" image="/iot-device.jpeg" tech="HARDWARE · IOT" number="02">
        <p slot="title" class="font-display font-semibold text-xl">An IoT device in <span class="text-brand">the workshop</span>.</p>
        <p slot="description" class="font-sans text-sm text-white/80">Built to make focus tangible — hardware that lives on your desk and keeps you on track.</p>
      </AppCard>

      <AppCard name="App" badge="TBA" logo="/logo.svg" image="/iot-device.jpeg" tech="APP · iOS & Android" number="03">
        <p slot="title" class="font-display font-semibold text-xl">The next app, <span class="text-brand">coming soon</span>.</p>
        <p slot="description" class="font-sans text-sm text-white/80">Another tool shaped by the same philosophy. Details on the way.</p>
      </AppCard>
    </div> -->

    <!-- <AppCard class="mt-6" name="App" badge="TBA" logo="/logo.svg" image="/iot-device.jpeg" tech="APP · iOS & Android" number="03">
      <p slot="title" class="font-display font-semibold text-xl">The next app, <span class="text-brand">coming soon</span>.</p>
      <p slot="description" class="font-sans text-sm text-white/80">Another tool shaped by the same philosophy. Details on the way.</p>
    </AppCard> -->

    <EmptyApp number="04" title="More coming soon" />
  </section>
</Container>
