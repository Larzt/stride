---
import Container from "./Container.astro";
---

<Container>
  <section class="mt-32 sm:mt-48 lg:mt-64">
    <div class="flex flex-col">
      <div class="flex flex-row items-center gap-x-2">
        <div class="p-0.5 border-1 border-brand rounded-full"/>
        <p class="text-xs text-white/60 font-mono">INDIE SOFTWARE & IOT STUDIO</p>
      </div>
      <div class="font-display">
        <h1 class="text-7xl sm:text-9xl lg:text-[12rem] font-bold leading-none">Stride</h1>
        <div class="flex flex-col gap-y-8 mt-8 lg:flex-row lg:justify-between lg:gap-y-0 lg:mt-12">
          <p class="font-display text-2xl sm:text-3xl lg:text-4xl">Apps built with <span class="text-brand">focus</span>, <br/> shipped with care.</p>
          <p class="font-sans text-white/60">A small studio making <span class="text-white/80">quality-of-life</span> software <br/> and devices — useful things that take the hard <br/> part off your plate, so you only deal with what <br/> matters.</p>
        </div>
      </div>
    </div>
  </section>
</Container>


