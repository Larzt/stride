---
interface Feature {
  color: string;   // clase de color del punto, p.ej. "bg-brand"
  title: string;
  text: string;
}

interface Props {
  name: string;
  logo: string;
  image: string;
  url?: string;
  badge?: string;
  tech?: string;     // tecnología, p.ej. "APP · iOS & Android" o "HARDWARE · IOT"
  number?: string;   // número del app, p.ej. "02"
  features?: Feature[];
  class?: string;
}

const { name, logo, image, url, badge, tech, number, features = [], class: className } = Astro.props;
const urlLabel = url?.replace(/^https?:\/\//, "");
---

<div class:list={["@container bg-secondary p-8 border-1 border-white/10 rounded-3xl h-full", className]}>
  <div class="grid grid-cols-1 @3xl:grid-cols-2 gap-8 h-full">
    <div class="flex flex-col">
      <div class="flex flex-row items-center gap-x-2">
        <img class="size-8" src={logo} alt={`Logo ${name}`} />
        <p class="font-sans font-semibold text-xl">{name}</p>
        {badge && (
          <p class="font-mono border-1 border-brand rounded-full px-2 text-[10px]">{badge}</p>
        )}
      </div>

      <div class="flex flex-col gap-y-4 mt-4">
        <slot name="title" />
        <slot name="description" />

        {features.length > 0 && (
          <div>
            {features.map((f) => (
              <div class="mt-3 flex flex-row gap-x-2 items-start">
                <div class:list={[f.color, "size-2 shrink-0 rounded-full mt-1.5"]} />
                <p class="font-sans text-sm text-white/80 text-pretty">
                  <span class="font-bold text-white">{f.title}</span> {f.text}
                </p>
              </div>
            ))}
          </div>
        )}
      </div>

      {url ? (
        <div class="flex flex-1 flex-row items-end gap-x-4 mt-6">
          <a href={url} class="open cursor-pointer bg-brand rounded-full py-3 px-6 font-semibold text-black">Open {name}</a>
          <a href={url} class="py-3 font-mono text-sm text-white/60">{urlLabel}</a>
        </div>
      ) : (
        <div class="flex flex-1 flex-row items-end justify-between mt-6 font-mono text-xs text-white/60">
          <p>{tech}</p>
          <p><span class="text-brand">{number}</span></p>
        </div>
      )}
    </div>

    <div class="order-first -mx-8 -mt-8 @3xl:order-none @3xl:mx-0 @3xl:mt-0 @3xl:ml-8">
      <img
        src={image}
        alt={`${name} mockup`}
        class="rounded-t-3xl @3xl:rounded-2xl w-full h-auto @3xl:w-auto @3xl:h-full @3xl:object-cover"
      />
    </div>
  </div>
</div>

<style>
  .open {
    transition: transform 300ms ease, box-shadow 300ms ease;
  }
  .open:hover {
    transform: translateY(-5px);
    box-shadow: 0 2px 25px -10px var(--color-brand);
  }
</style>
